{
  "name": "ethereal-theme",
  "displayName": "Ethereal Themes",
  "description": "Seventeen celestial, glossy, and Y2K-inspired color themes for Visual Studio Code.",
  "version": "0.0.6",
  "publisher": "ethereal-lemons",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ethereal-Lemons/Ethereal-Theme.git"
  },
  "bugs": {
    "url": "https://github.com/Ethereal-Lemons/Ethereal-Theme/issues"
  },
  "homepage": "https://github.com/Ethereal-Lemons/Ethereal-Theme#readme",
  "icon": "assets/ethereal-icon.png",
  "galleryBanner": {
    "color": "#161420",
    "theme": "dark"
  },
  "keywords": [
    "theme",
    "dark theme",
    "light theme",
    "ethereal",
    "angelical",
    "kerubin",
    "frutiger aero",
    "y2k",
    "windows 7",
    "chrome",
    "cyber",
    "millennium",
    "gothic",
    "luminous space",
    "fallen angel",
    "aesthetic"
  ],
  "scripts": {
    "generate:themes": "node scripts/generate_themes.mjs",
    "export:tui": "node scripts/export-tui-themes.mjs",
    "render:preview": "node scripts/render-marketplace-preview.mjs",
    "vscode:prepublish": "npm run generate:themes && npm run render:preview",
    "package": "npx --yes @vscode/vsce package --baseImagesUrl https://raw.githubusercontent.com/Ethereal-Lemons/Ethereal-Theme/main/",
    "publish": "npx --yes @vscode/vsce publish --baseImagesUrl https://raw.githubusercontent.com/Ethereal-Lemons/Ethereal-Theme/main/"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
